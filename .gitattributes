# Normalizacion de fin de linea para evitar que Git marque como "modificados"
# archivos que solo difieren en LF vs CRLF entre maquinas.
* text=auto

# Archivos de configuracion de Eclipse/Windows: CRLF
*.classpath text eol=crlf
*.project text eol=crlf
*.settings text eol=crlf
.settings/** text eol=crlf

# Codigo fuente y scripts: LF
*.java text eol=lf
*.sql text eol=lf
*.jsp text eol=lf
*.xml text eol=lf
*.md text eol=lf

# Binarios
*.jar binary
*.war binary
